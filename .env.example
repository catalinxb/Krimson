# Frontend Environment Configuration
# Copy this file to .env and update values for your setup

# ============================================
# LAN / Network Configuration
# ============================================
# For running server and client on different machines:
# 1. Set VITE_SERVER_URL to the backend server IP
# 2. Example: VITE_SERVER_URL="http://192.168.1.100:3001"

VITE_SERVER_URL="http://localhost:3001"

# Host to bind the Vite dev server (0.0.0.0 allows LAN access)
VITE_HOST="0.0.0.0"

# Port for the Vite dev server
VITE_PORT="5173"

# ============================================
# Example LAN Setup
# ============================================
# Server machine (running backend): IP = 192.168.1.100
# Client machine (running frontend): IP = 192.168.1.101
#
# On CLIENT machine, set:
# VITE_SERVER_URL="http://192.168.1.100:3001"
# VITE_HOST="0.0.0.0"
#
# On SERVER machine backend/.env, set:
# SERVER_HOST="0.0.0.0"
# ALLOWED_ORIGINS="http://192.168.1.101:5173"
# or ALLOWED_ORIGINS="*" for testing
