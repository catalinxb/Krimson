DATABASE_URL="file:./dev.db"
AUTH_SECRET="krimson-secret-2026-change-in-production"
USE_HTTPS="false"
HTTPS_PORT="3443"
SSL_CERT_PATH=""
SSL_KEY_PATH=""
NODE_ENV="development"

# LAN Configuration - Set to your server's IP address on the network
# Example: SERVER_HOST="192.168.1.100" or "0.0.0.0" to accept all connections
SERVER_HOST="0.0.0.0"
PORT="3001"

# CORS - Add your client machine's IP address(es)
# Format: "http://192.168.1.101:5173,http://192.168.1.102:5173"
# Or use "*" to allow all (not recommended for production)
ALLOWED_ORIGINS="*"

# Session timeout in seconds (30 minutes = 1800 seconds)
SESSION_TIMEOUT_SECONDS="1800"
