# Backend Environment Variables for Railway Production
# Copy these into your Railway dashboard

# Database Configuration
# For PostgreSQL (recommended for production):
# DATABASE_URL=postgresql://user:password@host:5432/database
# 
# For SQLite (simpler, but ephemeral on Railway):
DATABASE_URL=file:./dev.db

# Security
AUTH_SECRET=your-strong-secret-here-generate-with-openssl-rand-hex-32
NODE_ENV=production

# Network & HTTPS (Railway handles HTTPS at load balancer)
USE_HTTPS=false
SERVER_HOST=0.0.0.0
PORT=3000

# CORS - Set to your Railway frontend URL or "*" for development
ALLOWED_ORIGINS=*

# Session Configuration
SESSION_TIMEOUT_SECONDS=1800

# Email (for password recovery - optional)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
